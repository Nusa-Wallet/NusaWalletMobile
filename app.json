{
  "expo": {
    "name": "NusaWallet",
    "slug": "nusawallet",
    "version": "0.1.0",
    "scheme": "nusawallet",
    "icon": "./assets/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E2148"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.nusawallet.app",
      "adaptiveIcon": {
        "backgroundColor": "#0E2148",
        "foregroundImage": "./assets/app-logo.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/app-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4d1adac2-974f-434d-bc41-1618d31e6736"
      }
    }
  }
}
